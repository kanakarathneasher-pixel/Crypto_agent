# Local development. Public market data and paper trading need no Coinbase key.
OPENAI_API_KEY=
# Choose a model available to your OpenAI account that supports Responses tools.
OPENAI_MODEL=
DATABASE_URL=sqlite:///./crypto_agent.db
TRADING_MODE=paper
# Operator switch. Set true to allow users to Start their PAPER agent.
TRADING_ENABLED=false
TRADING_PAIR=XRP-USDC
MAX_TRADES_PER_DAY=5
MAX_POSITION_USDC=25
INITIAL_PAPER_BALANCE_USDC=1000
# ILLUSTRATIVE assumptions, not verified Coinbase account fee-tier quotes.
ESTIMATED_FEE_RATE=0.006
ESTIMATED_SLIPPAGE_RATE=0.001
MAX_DAILY_LOSS_USDC=25
MODEL_PATH=models/approved.json
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
ALLOWED_ORIGIN=http://localhost:3000
# Enable with HTTPS for hosted deployment.
COOKIE_SECURE=false
# Leave disabled. Enabling also requires a bound local user and explicit live configuration.
LIVE_EXECUTION_ENABLED=false
# Optional live settings: backend only, never put these in NEXT_PUBLIC variables.
# LIVE_OWNER_USER_ID=1
COINBASE_KEY_NAME=
COINBASE_PRIVATE_KEY=

# Your own account test: separate View-only ECDSA key. No Trade or Transfer.
# Create/sign into an Orbit account; its user ID appears under Account.
# COINBASE_READONLY_OWNER_USER_ID=123
COINBASE_READONLY_KEY_NAME=
# Keep PEM on one quoted line with literal \n separators, or use a quoted multiline value.
COINBASE_READONLY_PRIVATE_KEY=

# Google Identity Services Web application client ID (public identifier; no client secret).
GOOGLE_CLIENT_ID=
