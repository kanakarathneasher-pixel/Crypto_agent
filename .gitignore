# Generated datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Build, packaging, and coverage artifacts
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage/

# Frontend dependencies and generated output
.vercel/
node_modules/
.next/
out/
*.tsbuildinfo

